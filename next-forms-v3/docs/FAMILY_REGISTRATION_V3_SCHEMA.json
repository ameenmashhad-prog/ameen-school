  "student_card_model": {
    "fields": [
      "student_given_name",
      "student_father_name",
      "student_family_name",
      "student_full_name",
      "student_birth_date",
      "student_gender",
      "student_class_id",
      "student_section",
      "student_birth_place",
      "student_passport_number",
      "student_passport_expiry_date",
      "student_previous_school",
      "student_address_mashhad",
      "student_address_iraq",
      "student_photo",
      "student_username",
      "student_initial_password"
    ],
    "inheritance_rules": {
      "student_father_name": {
        "default_from": "guardian_given_name",
        "editable": true
      },
      "student_family_name": {
        "default_from": "family_name",
        "editable": true
      },
      "student_full_name": {
        "computed_from": [
          "student_given_name",
          "student_father_name",
          "student_family_name"
        ],
        "editable_override": true
      }
    }
  },
  "family_context": [
    "living_with_in_iran",
    "general_family_health_notes",
    "document_notes"
  ],
  "finance": {
    "fee_catalog_mode": "shared_family",
    "payment_rows": [
      "student_ref",
      "card_number",
      "tracking_number",
      "reference",
      "payment_date",
      "amount",
      "notes"
    ],
    "supports_shared_or_per_student": true
  },
  "documents": {
    "family_level": [
      "document_copy_received",
      "document_original_received"
    ],
    "attachments": [
      "health_attachment",
      "supporting_document"
    ]
  },
  "print_outputs": [
    "family_master_sheet",
    "student_appendix_per_student"
  ]
