{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "installCommand": "",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/exchange/tgju", "destination": "/api/exchange-tgju.js" },
    { "source": "/api/:path*", "destination": "/api/proxy.js" }
  ]
}
